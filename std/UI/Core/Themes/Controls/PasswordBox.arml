<?xml version="1.0" encoding="UTF-8"?>
<!-- PasswordBox：BasedOn Medium；默认 Template = DefaultControlTemplates.PasswordBox
     （PART_Chrome；掩码文本宿主层）。Template 由 AttachDefaultTemplates 挂载。 -->
<ResourceDictionary
    xmlns="http://schemas.arc.dev/winfx/2026"
    xmlns:x="http://schemas.arc.dev/xaml">
    <Style TargetType="PasswordBox" BasedOn="{StaticResource Medium}">
    </Style>
</ResourceDictionary>
