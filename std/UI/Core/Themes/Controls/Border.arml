<?xml version="1.0" encoding="UTF-8"?>
<!-- Border 隐式 Style：Surface 底 + Border 描边 + Radius.Control；禁 Class/SizeMode；禁裸 Thickness。 -->
<ResourceDictionary
    xmlns="http://schemas.arc.dev/winfx/2026"
    xmlns:x="http://schemas.arc.dev/xaml">
    <Style TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Size.Border.Thickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="{StaticResource Size.Border.Padding}"/>
    </Style>
</ResourceDictionary>
