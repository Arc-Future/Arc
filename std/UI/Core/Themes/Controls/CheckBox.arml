<?xml version="1.0" encoding="UTF-8"?>
<!-- CheckBox：BasedOn Medium；默认 Template = DefaultControlTemplates.CheckBox
     （PART_Glyph + PART_Content）。Template 由 AttachDefaultTemplates 挂载。 -->
<ResourceDictionary
    xmlns="http://schemas.arc.dev/winfx/2026"
    xmlns:x="http://schemas.arc.dev/xaml">
    <Style TargetType="CheckBox" BasedOn="{StaticResource Medium}">
    </Style>
</ResourceDictionary>
