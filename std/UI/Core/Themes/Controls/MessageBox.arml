<?xml version="1.0" encoding="UTF-8"?>
<!-- MessageBox 面板 Style：Dialog 卡片密度（Radius.Surface + Size.MessageBox.Padding）。
     程序面：Border Style="Panel" → 短键查找 Border.Panel 再全局 Panel（RFC 037 §0.1.1）。
     禁 Class/SizeMode；禁裸 Thickness / 裸 hex。Path 矢量图标 / 多实例队列另排。 -->
<ResourceDictionary
    xmlns="http://schemas.arc.dev/winfx/2026"
    xmlns:x="http://schemas.arc.dev/xaml">

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Size.Border.Thickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Surface}"/>
        <Setter Property="Padding" Value="{StaticResource Size.MessageBox.Padding}"/>
    </Style>
</ResourceDictionary>
