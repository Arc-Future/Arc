// Arc.UI — VerticalAlignment 垂直对齐强类型枚举（对标 WPF VerticalAlignment）。

namespace Arc.UI;

/// <summary>垂直对齐方式（对标 WPF `VerticalAlignment`）。成员顺序对齐 WPF。</summary>
public enum VerticalAlignment {
    /// <summary>顶部对齐。</summary>
    Top,
    /// <summary>垂直居中。</summary>
    Center,
    /// <summary>底部对齐。</summary>
    Bottom,
    /// <summary>拉伸填满可用高度。</summary>
    Stretch,
}
