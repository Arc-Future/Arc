// Arc.UI — HorizontalAlignment 水平对齐强类型枚举（对标 WPF HorizontalAlignment）。

namespace Arc.UI;

/// <summary>水平对齐方式（对标 WPF `HorizontalAlignment`）。成员顺序对齐 WPF。</summary>
public enum HorizontalAlignment {
    /// <summary>左对齐。</summary>
    Left,
    /// <summary>水平居中。</summary>
    Center,
    /// <summary>右对齐。</summary>
    Right,
    /// <summary>拉伸填满可用宽度。</summary>
    Stretch,
}
