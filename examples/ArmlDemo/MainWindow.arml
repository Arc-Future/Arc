<?xml version="1.0" encoding="UTF-8"?>
<!-- MainWindow.arml: TabControl built-in tab chrome + exclusive pages.
     色/chrome 走主题隐式 Style + App keyed Style（禁元素面裸 hex；StaticResource
     仅 Style= / Setter Value= 合法，见 arc-ui codegen）。 -->
<Window
    xmlns="http://schemas.arc.dev/winfx/2026"
    xmlns:x="http://schemas.arc.dev/xaml"
    x:Class="ArmlDemo.MainWindow"
    Title="ARML Demo - TabControl"
    Width="720"
    Height="640">
    <StackPanel Orientation="Vertical" Spacing="0">

        <TabControl x:Name="DemoTabs" SelectedIndex="0" Height="600">

            <TabItem Header="1 Hello">
                <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                    <TextBlock Text="1 - Hello tree and events"
                          FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="Hello, ARML!&#10;Nested element tree demo." FontSize="14"/>
                    <TextBlock Text="Custom FontFamily=AppSans"
                          FontFamily="AppSans" FontSize="14"/>
                    <TextBlock Text="AppSans Bold"
                          FontFamily="AppSans" FontWeight="Bold" FontSize="14"/>
                    <Button Content="Click Me" IsEnabled="true" Click="OnClickHello"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="2 Controls">
                <ScrollView VerticalScrollBarVisibility="Visible">
                    <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                        <TextBlock Text="2 - Controls (Style multi-bind / Toggle / Combo / Text)"
                              FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                        <TextBlock Text="Button: Style=&quot;{StaticResource Primary, Medium}&quot; (TargetType short keys; RFC 037; no Class/Appearance)."
                              FontSize="12"/>
                        <Button Content="Primary" Style="{StaticResource Primary}" Click="OnPrimaryClick"/>
                        <Button Content="Default" Style="{StaticResource Default}" Click="OnSecondaryClick"/>
                        <Button Content="Dashed" Style="{StaticResource Dashed}" Click="OnSecondaryClick"/>
                        <Button Content="Text" Style="{StaticResource Text}" Click="OnSecondaryClick"/>
                        <Button Content="Link" Style="{StaticResource Link}" Click="OnSecondaryClick"/>
                        <Button Content="Danger" Style="{StaticResource Danger}" Click="OnSecondaryClick"/>
                        <Button Content="Disabled Primary" Style="{StaticResource Primary}" IsEnabled="false"/>
                        <TextBlock Text="Size multi-bind (variant + size short keys):" FontSize="12"/>
                        <Button Content="SM Default" Style="{StaticResource Default, Small}"/>
                        <Button Content="MD Primary" Style="{StaticResource Primary, Medium}"/>
                        <Button Content="LG Danger" Style="{StaticResource Danger, Large}"/>
                        <TextBlock Text="Toggle family (CheckBox / ToggleButton / Radio + ChromeStateColor + Size short keys):" FontSize="12"/>
                        <CheckBox x:Name="FeatureCheck" Content="Enable feature" IsChecked="true"/>
                        <CheckBox Content="Check SM" Style="{StaticResource Small}" IsChecked="true"/>
                        <CheckBox Content="Check LG" Style="{StaticResource Large}"/>
                        <CheckBox Content="Disabled check" IsChecked="true" IsEnabled="false"/>
                        <ToggleButton x:Name="ModeToggle" Content="Toggle mode"/>
                        <ToggleButton Content="Toggle SM" Style="{StaticResource Small}"/>
                        <ToggleButton Content="Toggle LG" Style="{StaticResource Large}"/>
                        <TextBlock Text="RadioButton (group exclusive):" FontSize="12"/>
                        <RadioButton Content="Option A" IsChecked="true" GroupName="DemoOpts"/>
                        <RadioButton Content="Option B SM" Style="{StaticResource Small}" GroupName="DemoOpts"/>
                        <RadioButton Content="Option C LG" Style="{StaticResource Large}" GroupName="DemoOpts"/>
                        <TextBlock Text="ProgressBar:" FontSize="12"/>
                        <ProgressBar x:Name="LoadProgress" Minimum="0" Maximum="100" Value="35" Width="320" Height="10"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="72" Width="320" Height="10" IsEnabled="false"/>
                        <ProgressBar Width="320" Height="10" IsIndeterminate="true"/>
                        <TextBlock Text="ComboBox (ItemsSource non-generic · size short keys):" FontSize="12"/>
                        <ComboBox x:Name="ThemeCombo" Width="240"/>
                        <ComboBox Width="240" Style="{StaticResource Small}"/>
                        <ComboBox Width="240" Style="{StaticResource Large}"/>
                        <TextBlock Text="Popup (light-dismiss: backdrop / Esc · stacked Z LIFO):" FontSize="12"/>
                        <Button Content="Open demo Popup" Style="{StaticResource Default}" Click="OnOpenDemoPopup"/>
                        <Button Content="Open stacked Popup" Style="{StaticResource Default}" Click="OnOpenStackedPopup"/>
                        <TextBlock Text="Focus ring: Tab/arrows = IsFocusVisible; click TextBox clears ring" FontSize="12"/>
                        <TextBlock Text="MessageBox (Popup modal · IsLightDismissEnabled=false):" FontSize="12"/>
                        <Button Content="MessageBox OK" Style="{StaticResource Primary}" Click="OnShowMessageBoxOk"/>
                        <Button Content="MessageBox OKCancel" Style="{StaticResource Default}" Click="OnShowMessageBoxOkCancel"/>
                        <Button Content="MessageBox YesNo" Style="{StaticResource Default}" Click="OnShowMessageBoxYesNo"/>
                        <Button Content="MessageBox YesNoCancel" Style="{StaticResource Dashed}" Click="OnShowMessageBoxYesNoCancel"/>
                        <TextBlock Text="Nested ScrollView (wheel / thumb):" FontSize="12"/>
                        <ScrollView Height="120" VerticalScrollBarVisibility="Visible">
                            <StackPanel Orientation="Vertical" Spacing="6">
                                <TextBlock Text="Row 01 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 02 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 03 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 04 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 05 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 06 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 07 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 08 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 09 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 10 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 11 - scroll me" FontSize="12"/>
                                <TextBlock Text="Row 12 - scroll me" FontSize="12"/>
                            </StackPanel>
                        </ScrollView>
                        <TextBlock Text="TextBox Size short keys (Shared Small/Medium/Large; Padding skipped if no DP):" FontSize="12"/>
                        <TextBox Placeholder="MD (implicit)" Width="320"/>
                        <TextBox Placeholder="SM" Style="{StaticResource Small}" Width="320"/>
                        <TextBox Placeholder="LG" Style="{StaticResource Large}" Width="320"/>
                        <TextBlock Text="PasswordBox (masked · Paste OK · no Copy/Cut):" FontSize="12"/>
                        <PasswordBox x:Name="DemoPassword" Placeholder="Password" Width="320"/>
                        <PasswordBox Placeholder="SM" Style="{StaticResource Small}" Width="320"/>
                        <PasswordBox Placeholder="LG" Style="{StaticResource Large}" Width="320"/>
                        <TextBlock Text="Border (Surface + Border token · Child):" FontSize="12"/>
                        <Border Width="320">
                            <StackPanel Orientation="Vertical" Spacing="6">
                                <TextBlock Text="Inside Border" FontSize="12"/>
                                <TextBlock Text="Background/BorderBrush/CornerRadius from implicit Style" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollView>
            </TabItem>

            <TabItem Header="3 Bind">
                <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                    <TextBlock Text="3 - x:Bind (SyncText → Invalidate → wgpu)" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="Change Message triggers [Observable] → SyncText → FramePump.Invalidate → redraw." FontSize="12"/>
                    <TextBlock Text="{x:Bind Message, Mode=OneWay}" FontSize="14"/>
                    <Button Content="Change Message" Style="{StaticResource Primary}" Click="OnChangeMessage"/>
                    <Button Content="Default bind action" Style="{StaticResource Default}" Click="OnChangeMessage"/>
                    <Button Content="Append tick" Style="{StaticResource Dashed}" Click="OnAppendMessage"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="4 List">
                <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                    <TextBlock Text="4 - ListView / ItemsControl" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="Click row to select (PointerRouter SelectionChanged)." FontSize="12"/>
                    <ListView x:Name="ItemsList" Height="280" Width="640"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="5 Media">
                <ScrollView VerticalScrollBarVisibility="Visible">
                    <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                        <TextBlock Text="5 - Image + Slider" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                        <Image Source="assets/logo.png" Width="128" Height="128" Stretch="Uniform"/>
                        <Image Source="assets/logo.bmp" Stretch="None" Width="128" Height="128"/>
                        <TextBlock x:Name="VolumeLabel" Text="Volume: 25" FontSize="12"/>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="25" Width="320" Height="24"/>
                        <Slider Minimum="0" Maximum="100" Value="50" Width="320"/>
                        <Slider Minimum="0" Maximum="100" Value="75" Width="320" IsEnabled="false"/>
                    </StackPanel>
                </ScrollView>
            </TabItem>

            <TabItem Header="6 IME">
                <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                    <TextBlock Text="6 - IME / TextBox" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="English direct / Chinese IME + caret; Tab moves focus." FontSize="12"/>
                    <TextBox x:Name="NameInput"
                           Placeholder="Type hello or Chinese..."
                           Width="360"
                           Height="32"
                           FontSize="14"/>
                    <TextBox Placeholder="Second field (Tab)"
                           Width="360"
                           Height="32"
                           FontSize="14"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="7 Style">
                <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                    <TextBlock Text="7 - Style and Isolation" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="Explicit keyed DangerButtonStyle (Rest=error) vs Style multi-bind; Hover still overrides via VSM." FontSize="12"/>
                    <Button Content="Default Primary (implicit Style)"/>
                    <Button Content="Explicit Danger Style" Style="{StaticResource DangerButtonStyle}"/>
                    <Button Content="Built-in Danger (short key)" Style="{StaticResource Danger}"/>
                    <Button Content="Primary + Large (short keys)" Style="{StaticResource Primary, Large}"/>
                    <TextBlock Text="Lookup: {T}.K then global Shared K (size ladder). No Size.SM dual track." FontSize="12"/>
                    <VisualHost Height="120">
                        <StackPanel Orientation="Vertical" Spacing="8" Margin="8,8,8,8">
                            <TextBlock Text="Inside VisualHost (isolated Light Theme)" FontSize="12"/>
                            <Button Content="Preview Primary"/>
                        </StackPanel>
                    </VisualHost>
                </StackPanel>
            </TabItem>

            <TabItem Header="8 Data">
                <ScrollView VerticalScrollBarVisibility="Visible">
                    <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                        <TextBlock Text="8 - CodeEditor + DataGrid" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                        <TextBlock Text="Editor virtualized lines; grid click selects row." FontSize="12"/>
                        <CodeEditor x:Name="EditorView" Width="640" Height="200"/>
                        <DataGrid x:Name="BooksGrid" Width="640" Height="200"/>
                    </StackPanel>
                </ScrollView>
            </TabItem>

            <TabItem Header="9 Tree">
                <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                    <TextBlock Text="9 - TreeView ItemsSource FlatIndex viewport (M-VZ4 min)" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="ItemsSource=List&lt;TreeNode&gt;; FlatIndex window + recycle pool; Click/Tab + Up/Down Home/End; Left/Right expand. Honest: shallow FlatIndex virt (not full path virt)." FontSize="12"/>
                    <TextBlock x:Name="TreeSelectionLabel" Text="Selected: (none)" FontSize="12"/>
                    <TreeView x:Name="DemoTree" Width="640" Height="320"/>
                </StackPanel>
            </TabItem>

            <!-- 溢出冒烟：长 Header 挤栏 → 顶栏滚轮水平滚 + 点击命中跟 HeaderScrollOffset -->
            <TabItem Header="10 Overflow Alpha Long Title">
                <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                    <TextBlock Text="10 - Tab overflow scroll smoke" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="Wheel over the tab bar to scroll headers; click still hits the correct tab." FontSize="12"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="11 Overflow Beta Extra Wide">
                <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                    <TextBlock Text="11 - Second overflow page" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="Selecting this tab auto-scrolls it into the visible header strip." FontSize="12"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="12 Overflow Gamma Crowded">
                <StackPanel Orientation="Vertical" Spacing="10" Margin="16,12,16,12">
                    <TextBlock Text="12 - Third overflow page" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="No switch animation / close button in this slice." FontSize="12"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </StackPanel>
</Window>
