<?xml version="1.0" encoding="UTF-8"?>
<!-- MainWindow.arml: TabControl built-in tab chrome + exclusive pages.
     色/chrome 走主题隐式 Style + App keyed Style（禁元素面裸 hex；StaticResource
     仅 Style= / Setter Value= 合法，见 arc-ui codegen）。
     UX：落地页 / Controls 分区密度 / 页眉 Caption；溢出页签仍长 Header 冒烟。 -->
<Window
    xmlns="http://schemas.arc.dev/winfx/2026"
    xmlns:x="http://schemas.arc.dev/xaml"
    x:Class="ArmlDemo.MainWindow"
    Title="Arc.UI — ArmlDemo"
    Width="880"
    Height="720">
    <StackPanel Orientation="Vertical" Spacing="0">

        <TabControl x:Name="DemoTabs" SelectedIndex="0" Height="680">

            <TabItem Header="Hello">
                <ScrollView VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Spacing="14" Margin="20,16,20,16">
                        <TextBlock Text="Arc.UI showcase"
                              FontSize="22" Style="{StaticResource Demo.SectionTitle}"/>
                        <TextBlock Text="Single wgpu backend · Ant Design 6.x tokens · WPF-shaped surface. Browse tabs for controls, binding, lists, media, and data."
                              FontSize="13" Style="{StaticResource Demo.Caption}"/>
                        <Border Width="520">
                            <StackPanel Orientation="Vertical" Spacing="8" Margin="12,10,12,10">
                                <TextBlock Text="Custom font (AppSans)" FontSize="13" Style="{StaticResource Demo.SectionTitle}"/>
                                <TextBlock Text="Hello, ARML — nested element tree." FontSize="14"/>
                                <TextBlock Text="AppSans regular · FontFamily demo"
                                      FontFamily="AppSans" FontSize="14"/>
                                <TextBlock Text="AppSans Bold"
                                      FontFamily="AppSans" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Events: Click= handler · RelayCommand on the Primary button (code-behind; ARML Command bind deferred)."
                              FontSize="12" Style="{StaticResource Demo.Caption}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="HelloCommandButton" Content="RelayCommand" Style="{StaticResource Primary}"/>
                            <Button Content="Click Me" Style="{StaticResource Default}" Click="OnClickHello"/>
                        </StackPanel>
                        <TextBlock x:Name="HelloStatusLabel" Text="Ready — try RelayCommand or Click Me."
                              FontSize="12" Style="{StaticResource Demo.Caption}"/>
                    </StackPanel>
                </ScrollView>
            </TabItem>

            <TabItem Header="Controls">
                <ScrollView VerticalScrollBarVisibility="Visible">
                    <StackPanel Orientation="Vertical" Spacing="16" Margin="20,16,20,16">
                        <TextBlock Text="Controls gallery"
                              FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                        <TextBlock Text="Style short keys (Primary, Medium) · Size ladder · Toggle family · Popup / MessageBox. Not a pixel-perfect Ant clone."
                              FontSize="12" Style="{StaticResource Demo.Caption}"/>

                        <Border>
                            <StackPanel Orientation="Vertical" Spacing="10" Margin="12,10,12,10">
                                <TextBlock Text="Buttons — variants" FontSize="13" Style="{StaticResource Demo.SectionTitle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Primary" Style="{StaticResource Primary}" Click="OnPrimaryClick"/>
                                    <Button Content="Default" Style="{StaticResource Default}" Click="OnSecondaryClick"/>
                                    <Button Content="Dashed" Style="{StaticResource Dashed}" Click="OnSecondaryClick"/>
                                    <Button Content="Text" Style="{StaticResource Text}" Click="OnSecondaryClick"/>
                                    <Button Content="Link" Style="{StaticResource Link}" Click="OnSecondaryClick"/>
                                    <Button Content="Danger" Style="{StaticResource Danger}" Click="OnSecondaryClick"/>
                                    <Button Content="Disabled" Style="{StaticResource Primary}" IsEnabled="false"/>
                                </StackPanel>
                                <TextBlock Text="Size multi-bind (variant + Small/Medium/Large)" FontSize="12" Style="{StaticResource Demo.Caption}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="SM Default" Style="{StaticResource Default, Small}"/>
                                    <Button Content="MD Primary" Style="{StaticResource Primary, Medium}"/>
                                    <Button Content="LG Danger" Style="{StaticResource Danger, Large}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel Orientation="Vertical" Spacing="10" Margin="12,10,12,10">
                                <TextBlock Text="Toggle family" FontSize="13" Style="{StaticResource Demo.SectionTitle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox x:Name="FeatureCheck" Content="Enable feature" IsChecked="true"/>
                                    <CheckBox Content="SM" Style="{StaticResource Small}" IsChecked="true"/>
                                    <CheckBox Content="LG" Style="{StaticResource Large}"/>
                                    <CheckBox Content="Disabled" IsChecked="true" IsEnabled="false"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ToggleButton x:Name="ModeToggle" Content="Toggle mode"/>
                                    <ToggleButton Content="SM" Style="{StaticResource Small}"/>
                                    <ToggleButton Content="LG" Style="{StaticResource Large}"/>
                                </StackPanel>
                                <TextBlock Text="RadioButton (GroupName exclusive)" FontSize="12" Style="{StaticResource Demo.Caption}"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <RadioButton Content="Option A" IsChecked="true" GroupName="DemoOpts"/>
                                    <RadioButton Content="Option B SM" Style="{StaticResource Small}" GroupName="DemoOpts"/>
                                    <RadioButton Content="Option C LG" Style="{StaticResource Large}" GroupName="DemoOpts"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel Orientation="Vertical" Spacing="10" Margin="12,10,12,10">
                                <TextBlock Text="Progress · Combo · focus ring" FontSize="13" Style="{StaticResource Demo.SectionTitle}"/>
                                <ProgressBar x:Name="LoadProgress" Minimum="0" Maximum="100" Value="35" Width="360" Height="10"/>
                                <ProgressBar Minimum="0" Maximum="100" Value="72" Width="360" Height="10" IsEnabled="false"/>
                                <ProgressBar Width="360" Height="10" IsIndeterminate="true"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ComboBox x:Name="ThemeCombo" Width="200"/>
                                    <ComboBox Width="140" Style="{StaticResource Small}"/>
                                    <ComboBox Width="160" Style="{StaticResource Large}"/>
                                </StackPanel>
                                <TextBlock Text="Focus ring: Tab/arrows = IsFocusVisible; click TextBox clears ring."
                                      FontSize="12" Style="{StaticResource Demo.Caption}"/>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel Orientation="Vertical" Spacing="10" Margin="12,10,12,10">
                                <TextBlock Text="Popup · MessageBox" FontSize="13" Style="{StaticResource Demo.SectionTitle}"/>
                                <TextBlock Text="Light-dismiss Popup (backdrop / Esc) · stacked Z LIFO · MessageBox modal (no native dialog)."
                                      FontSize="12" Style="{StaticResource Demo.Caption}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open Popup" Style="{StaticResource Default}" Click="OnOpenDemoPopup"/>
                                    <Button Content="Stacked Popup" Style="{StaticResource Default}" Click="OnOpenStackedPopup"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="OK" Style="{StaticResource Primary}" Click="OnShowMessageBoxOk"/>
                                    <Button Content="OKCancel" Style="{StaticResource Default}" Click="OnShowMessageBoxOkCancel"/>
                                    <Button Content="YesNo" Style="{StaticResource Default}" Click="OnShowMessageBoxYesNo"/>
                                    <Button Content="YesNoCancel" Style="{StaticResource Dashed}" Click="OnShowMessageBoxYesNoCancel"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel Orientation="Vertical" Spacing="10" Margin="12,10,12,10">
                                <TextBlock Text="Nested ScrollView" FontSize="13" Style="{StaticResource Demo.SectionTitle}"/>
                                <ScrollView Height="100" VerticalScrollBarVisibility="Visible">
                                    <StackPanel Orientation="Vertical" Spacing="6">
                                        <TextBlock Text="Row 01 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 02 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 03 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 04 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 05 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 06 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 07 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 08 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 09 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 10 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 11 — scroll me" FontSize="12"/>
                                        <TextBlock Text="Row 12 — scroll me" FontSize="12"/>
                                    </StackPanel>
                                </ScrollView>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel Orientation="Vertical" Spacing="10" Margin="12,10,12,10">
                                <TextBlock Text="Text · Password · Border" FontSize="13" Style="{StaticResource Demo.SectionTitle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBox Placeholder="MD (implicit)" Width="200"/>
                                    <TextBox Placeholder="SM" Style="{StaticResource Small}" Width="160"/>
                                    <TextBox Placeholder="LG" Style="{StaticResource Large}" Width="200"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PasswordBox x:Name="DemoPassword" Placeholder="Password" Width="200"/>
                                    <PasswordBox Placeholder="SM" Style="{StaticResource Small}" Width="160"/>
                                    <PasswordBox Placeholder="LG" Style="{StaticResource Large}" Width="200"/>
                                </StackPanel>
                                <TextBlock Text="PasswordBox: Paste OK · no Copy/Cut. Border uses Surface + Border tokens."
                                      FontSize="12" Style="{StaticResource Demo.Caption}"/>
                                <Border Width="360">
                                    <StackPanel Orientation="Vertical" Spacing="6" Margin="10,8,10,8">
                                        <TextBlock Text="Inside Border" FontSize="12"/>
                                        <TextBlock Text="Background / BorderBrush / CornerRadius from implicit Style"
                                              FontSize="12" Style="{StaticResource Demo.Caption}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollView>
            </TabItem>

            <TabItem Header="Bind">
                <StackPanel Orientation="Vertical" Spacing="12" Margin="20,16,20,16">
                    <TextBlock Text="x:Bind live path" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="x:Bind OneWay + Observable → SyncText → Invalidate → wgpu. Runtime Binding path deferred."
                          FontSize="12" Style="{StaticResource Demo.Caption}"/>
                    <Border Width="480">
                        <StackPanel Orientation="Vertical" Spacing="10" Margin="14,12,14,12">
                            <TextBlock Text="Bound message" FontSize="12" Style="{StaticResource Demo.Caption}"/>
                            <TextBlock Text="{x:Bind Message, Mode=OneWay}" FontSize="16"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Change Message" Style="{StaticResource Primary}" Click="OnChangeMessage"/>
                                <Button Content="Reset" Style="{StaticResource Default}" Click="OnChangeMessage"/>
                                <Button Content="Append tick" Style="{StaticResource Dashed}" Click="OnAppendMessage"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="List">
                <StackPanel Orientation="Vertical" Spacing="12" Margin="20,16,20,16">
                    <TextBlock Text="ListView" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="Click to select · keyboard ↑↓ Home/End/Enter · Observable multi-instance smoke in OnLoaded."
                          FontSize="12" Style="{StaticResource Demo.Caption}"/>
                    <TextBlock x:Name="ListSelectionLabel" Text="Selected: (none)" FontSize="12" Style="{StaticResource Demo.Caption}"/>
                    <ListView x:Name="ItemsList" Height="360" Width="720"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Media">
                <ScrollView VerticalScrollBarVisibility="Visible">
                    <StackPanel Orientation="Vertical" Spacing="12" Margin="20,16,20,16">
                        <TextBlock Text="Image + Slider" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                        <TextBlock Text="Texture decode + ValueChanged label sync (drag / click)."
                              FontSize="12" Style="{StaticResource Demo.Caption}"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Image Source="assets/logo.png" Width="128" Height="128" Stretch="Uniform"/>
                            <Image Source="assets/logo.bmp" Stretch="None" Width="128" Height="128"/>
                        </StackPanel>
                        <Border Width="400">
                            <StackPanel Orientation="Vertical" Spacing="8" Margin="12,10,12,10">
                                <TextBlock x:Name="VolumeLabel" Text="Volume: 25" FontSize="13"/>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="25" Width="360" Height="24"/>
                                <Slider Minimum="0" Maximum="100" Value="50" Width="360"/>
                                <Slider Minimum="0" Maximum="100" Value="75" Width="360" IsEnabled="false"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollView>
            </TabItem>

            <TabItem Header="IME">
                <StackPanel Orientation="Vertical" Spacing="12" Margin="20,16,20,16">
                    <TextBlock Text="IME / TextBox" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="English direct / Chinese IME + caret · Tab focus · Ctrl+C/V/X · double-click word select."
                          FontSize="12" Style="{StaticResource Demo.Caption}"/>
                    <Border Width="420">
                        <StackPanel Orientation="Vertical" Spacing="10" Margin="14,12,14,12">
                            <TextBox x:Name="NameInput"
                                   Placeholder="Type hello or Chinese…"
                                   Width="380"
                                   Height="32"
                                   FontSize="14"/>
                            <TextBox Placeholder="Second field (Tab)"
                                   Width="380"
                                   Height="32"
                                   FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Style">
                <StackPanel Orientation="Vertical" Spacing="12" Margin="20,16,20,16">
                    <TextBlock Text="Style isolation" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="Keyed DangerButtonStyle vs short keys · VisualHost Light preview. No Class/Appearance dual track."
                          FontSize="12" Style="{StaticResource Demo.Caption}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Default Primary"/>
                        <Button Content="Explicit Danger" Style="{StaticResource DangerButtonStyle}"/>
                        <Button Content="Danger key" Style="{StaticResource Danger}"/>
                        <Button Content="Primary + Large" Style="{StaticResource Primary, Large}"/>
                    </StackPanel>
                    <TextBlock Text="Lookup: {T}.K then Shared size ladder. No Size.SM dual track."
                          FontSize="12" Style="{StaticResource Demo.Caption}"/>
                    <VisualHost Height="140" Width="480">
                        <StackPanel Orientation="Vertical" Spacing="8" Margin="12,10,12,10">
                            <TextBlock Text="VisualHost — isolated Light Theme" FontSize="12"/>
                            <Button Content="Preview Primary" Style="{StaticResource Primary}"/>
                        </StackPanel>
                    </VisualHost>
                </StackPanel>
            </TabItem>

            <TabItem Header="Data">
                <ScrollView VerticalScrollBarVisibility="Visible">
                    <StackPanel Orientation="Vertical" Spacing="12" Margin="20,16,20,16">
                        <TextBlock Text="CodeEditor + DataGrid" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                        <TextBlock Text="Virtualized editor lines · grid select / multi-select mods · Observable row increment."
                              FontSize="12" Style="{StaticResource Demo.Caption}"/>
                        <CodeEditor x:Name="EditorView" Width="780" Height="220"/>
                        <DataGrid x:Name="BooksGrid" Width="780" Height="220"/>
                    </StackPanel>
                </ScrollView>
            </TabItem>

            <TabItem Header="Tree">
                <StackPanel Orientation="Vertical" Spacing="12" Margin="20,16,20,16">
                    <TextBlock Text="TreeView" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="ItemsSource FlatIndex viewport (M-VZ4 min) · Click/Tab · ↑↓ Home/End · Left/Right expand. Shallow virt — not full path virt."
                          FontSize="12" Style="{StaticResource Demo.Caption}"/>
                    <TextBlock x:Name="TreeSelectionLabel" Text="Selected: (none)" FontSize="12" Style="{StaticResource Demo.Caption}"/>
                    <TreeView x:Name="DemoTree" Width="780" Height="400"/>
                </StackPanel>
            </TabItem>

            <!-- 溢出冒烟：长 Header 挤栏 → 顶栏滚轮水平滚 + 点击命中跟 HeaderScrollOffset -->
            <TabItem Header="10 Overflow Alpha Long Title">
                <StackPanel Orientation="Vertical" Spacing="12" Margin="20,16,20,16">
                    <TextBlock Text="Tab overflow scroll" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="Wheel over the tab bar to scroll headers; click still hits the correct tab."
                          FontSize="12" Style="{StaticResource Demo.Caption}"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="11 Overflow Beta Extra Wide">
                <StackPanel Orientation="Vertical" Spacing="12" Margin="20,16,20,16">
                    <TextBlock Text="Second overflow page" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="Selecting this tab auto-scrolls it into the visible header strip."
                          FontSize="12" Style="{StaticResource Demo.Caption}"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="12 Overflow Gamma Crowded">
                <StackPanel Orientation="Vertical" Spacing="12" Margin="20,16,20,16">
                    <TextBlock Text="Third overflow page" FontSize="15" Style="{StaticResource Demo.SectionTitle}"/>
                    <TextBlock Text="No switch animation / close button in this slice."
                          FontSize="12" Style="{StaticResource Demo.Caption}"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </StackPanel>
</Window>
